{
  "name": "esign-frontend",
  "private": true,
  "description": "Applications frontend de la plateforme de signature électronique (FSBM)",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w @esign/backoffice",
    "build": "npm run build -w @esign/backoffice",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "api:generate": "openapi-typescript http://localhost:8080/v3/api-docs -o packages/api/src/schema.d.ts"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}

{
  "name": "esign-frontend",
  "private": true,
  "description": "Applications frontend de la plateforme de signature électronique (FSBM)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @esign/backoffice -w @esign/etudiant",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "api:generate": "openapi-typescript http://localhost:8080/v3/api-docs -o packages/api/src/schema.d.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:rapport": "playwright show-report e2e/rapport"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}

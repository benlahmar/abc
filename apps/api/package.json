{
  "name": "@fsbm/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de contenu du portail FSBM (Node.js / Express).",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "seed:demo": "tsx src/cli/seed-demo.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fsbm/shared": "*",
    "@node-rs/argon2": "^2.2.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vitest": "^5.0.1"
  }
}

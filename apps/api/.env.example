# Port d'écoute de l'API
PORT=4000
# Dossier des collections JSON (par défaut : apps/api/data)
DATA_DIR=
# Dossier des données écrites par l'API (messages de contact) — par défaut : apps/api/storage
STORAGE_DIR=
# Origines autorisées en CORS, séparées par des virgules (inutile si le front est servi par l'API)
CORS_ORIGIN=http://localhost:5173
# Dossier du front-end compilé à servir (par défaut : apps/web/dist si présent)
WEB_DIST=
# PostgreSQL (obligatoire en production). Sans cette variable : base PGlite locale dans PGLITE_DIR
DATABASE_URL=
PGLITE_DIR=
# Premier administrateur, créé au démarrage s'il n'en existe aucun (mot de passe à changer à la 1re connexion)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Cookies « Secure » (true par défaut quand NODE_ENV=production)
SECURE_COOKIES=
# Durée d'une session du back-office, en heures
SESSION_TTL_HOURS=12
# Dossier du back-office compilé (par défaut : apps/admin/dist si présent)
ADMIN_DIST=
